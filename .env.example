# Скопируй этот файл в .env и заполни. Файл .env в git не попадает.

# Токен бота ORBIT от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать: @userinfobot). У админа открыты все приложения бесплатно.
ADMIN_IDS=

# Публичный адрес сервера. На Railway можно не заполнять — подставится сам.
# Локально Mini App из Telegram не откроется без https-адреса (см. README).
PUBLIC_URL=

# Ключи для твоих приложений: код:ключ через запятую. Ключ — минимум 16 символов.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Пример: HUB_APP_KEYS=mera:Xk2...,velora:p9Q...,delta:Lm4...
HUB_APP_KEYS=

# Куда писать по вопросам оплаты (для /paysupport), например @arche7
SUPPORT_CONTACT=

# Название хаба (необязательно)
HUB_NAME=ORBIT

# DATABASE_URL на Railway появится сам после добавления PostgreSQL.
# Локально оставь пустым — будет файл orbit.db.
DATABASE_URL=
